    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Taxa de 5xx (%) por serviço",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "err",
                "query": "sum:http.server.requests.count{$env,$service,status:5*} by {service}.as_count()"
