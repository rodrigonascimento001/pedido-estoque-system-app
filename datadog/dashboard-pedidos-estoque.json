{
  "title": "Pedidos e Estoque: saga e saúde dos serviços",
  "description": "Saga de pedidos via Kafka (pedido-service, estoque-service, api-gateway). Usa apenas métricas liberadas na allowlist do perfil datadog e as métricas de JVM do agente.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "default": "*"
    },
    {
      "name": "service",
      "prefix": "service",
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "Saga de pedidos (pedido-service)",
        "background_color": "gray",
        "font_size": "16",
        "text_align": "left",
        "vertical_align": "center",
        "show_tick": false,
        "tick_edge": "left",
        "tick_pos": "50%",
        "has_padding": true
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 1
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Pedidos criados",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "a",
                "query": "sum:pedido.criado{$env}.as_count()",
                "aggregator": "sum"
              }
            ],
            "formulas": [
              {
                "formula": "a"
              }
            ]
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 1,
        "width": 3,
        "height": 2
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Confirmados",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "a",
                "query": "sum:pedido.confirmado{$env}.as_count()",
                "aggregator": "sum"
              }
            ],
            "formulas": [
              {
                "formula": "a"
              }
            ]
          }
        ]
      },
      "layout": {
        "x": 3,
        "y": 1,
        "width": 3,
        "height": 2
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Cancelados",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "a",
                "query": "sum:pedido.cancelado{$env}.as_count()",
                "aggregator": "sum"
              }
            ],
            "formulas": [
              {
                "formula": "a"
              }
            ]
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 1,
        "width": 3,
        "height": 2
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Taxa de cancelamento",
        "autoscale": true,
        "precision": 1,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "a",
                "query": "sum:pedido.cancelado{$env}.as_count()",
                "aggregator": "sum"
              },
              {
                "data_source": "metrics",
                "name": "b",
                "query": "sum:pedido.confirmado{$env}.as_count()",
                "aggregator": "sum"
              }
            ],
            "formulas": [
              {
                "formula": "100 * a / (a + b)"
              }
            ],
            "conditional_formats": [
              {
                "comparator": ">",
                "value": 20,
                "palette": "white_on_red"
              },
              {
                "comparator": ">",
                "value": 10,
                "palette": "white_on_yellow"
              },
              {
                "comparator": "<=",
                "value": 10,
                "palette": "white_on_green"
              }
            ]
          }
        ],
        "custom_unit": "%"
      },
      "layout": {
        "x": 9,
        "y": 1,
        "width": 3,
        "height": 2
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Pedidos por desfecho",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "criados",
                "query": "sum:pedido.criado{$env}.as_count()"
              },
              {
                "data_source": "metrics",
                "name": "confirmados",
                "query": "sum:pedido.confirmado{$env}.as_count()"
              },
              {
                "data_source": "metrics",
                "name": "cancelados",
                "query": "sum:pedido.cancelado{$env}.as_count()"
              }
            ],
            "formulas": [
              {
                "formula": "criados",
                "alias": "criados"
              },
              {
                "formula": "confirmados",
                "alias": "confirmados"
              },
              {
                "formula": "cancelados",
                "alias": "cancelados"
              }
            ],
            "display_type": "bars"
          }
        ],
        "yaxis": {
          "include_zero": true
        }
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 6,
        "height": 3
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Duração da saga (ms): média e p95 por desfecho",
        "show_legend": true,
        "legend_layout": "auto",
        "requests": [
          {
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "media",
                "query": "avg:pedido.saga.duracao.avg{$env} by {resultado}"
              },
              {
                "data_source": "metrics",
                "name": "p95",
                "query": "avg:pedido.saga.duracao.95percentile{$env} by {resultado}"
              }
            ],
            "formulas": [
              {
                "formula": "media"
              },
              {
                "formula": "p95"
              }
            ],
            "display_type": "line"
          }
        ],
        "yaxis": {
          "include_zero": true
        },
        "markers": [
          {
            "value": "y = 5000",
            "display_type": "error dashed",
            "label": "limite do monitor (p95)"
          }
        ]
      },
      "layout": {
        "x": 6,
        "y": 3,
        "width": 6,
        "height": 3
      }
    },
