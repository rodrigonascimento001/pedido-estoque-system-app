# Copy to .env (already ignored by git) for application configuration.
# DD_API_KEY and DD_SITE belong in pedido-estoque-system-infra/.env,
# because the Datadog Agent is defined in that repository's Compose project.
DD_ENV=local

# To send telemetry, start the infrastructure Agent, then enable these values:
# SPRING_PROFILES_ACTIVE=datadog
# DD_AGENT_HOST=datadog-agent
# DD_TRACE_ENABLED=true

# Local PostgreSQL development credentials.
DB_USER=postgres
DB_PASSWORD=postgres

# Datadog application settings (disabled by default).
SPRING_PROFILES_ACTIVE=default
DD_AGENT_HOST=datadog-agent
DD_TRACE_ENABLED=false
DD_VERSION=local