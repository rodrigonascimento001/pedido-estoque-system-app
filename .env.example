# Copy to .env (already ignored by git) for application configuration.
# DD_API_KEY and DD_SITE belong in pedido-estoque-system-infra/.env,
# because the Datadog Agent is defined in that repository's Compose project.
DD_ENV=local

# To send telemetry, start the infrastructure Agent, then enable these values:
# SPRING_PROFILES_ACTIVE=datadog
# DD_AGENT_HOST=datadog-agent
# DD_TRACE_ENABLED=true

# Local PostgreSQL development credentials (usadas apenas sem o perfil aws).
DB_USER=postgres
DB_PASSWORD=postgres

# Fluxo local com LocalStack (perfil localstack no repositório de infraestrutura).
# Para usar segredos do Secrets Manager, troque SPRING_PROFILES_ACTIVE por
# aws (ou aws,datadog) e mantenha as variáveis abaixo. Sem o perfil aws elas
# são inofensivas.
APP_ENV=local
# Endpoint usado pelos containers do Compose. Ao rodar os serviços na máquina
# host (mvn spring-boot:run), troque localstack por localhost.
SPRING_CLOUD_AWS_ENDPOINT=http://localstack:4566
SPRING_CLOUD_AWS_REGION_STATIC=us-east-1
SPRING_CLOUD_AWS_CREDENTIALS_ACCESS_KEY=test
SPRING_CLOUD_AWS_CREDENTIALS_SECRET_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Em AWS real: remova/ajuste o endpoint e use credenciais da task role.

# Datadog application settings (disabled by default).
SPRING_PROFILES_ACTIVE=default
DD_AGENT_HOST=datadog-agent
DD_TRACE_ENABLED=false
DD_VERSION=local